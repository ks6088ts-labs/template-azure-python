# ---------
# Project environment variables
# ---------

# Project Settings
PROJECT_NAME=template-azure-python
PROJECT_LOG_LEVEL=INFO

# ---------
# Microsoft Foundry
# ---------

# Format: https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
# Requires Foundry User on the account for the caller and project managed identity.
# See docs/foundry.md for RBAC setup and HTTP 403 troubleshooting.
FOUNDRY_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>

# ---------
# Azure Cosmos DB for NoSQL
# ---------

# Format: https://<account-name>.documents.azure.com:443/
AZURE_COSMOS_DB_ENDPOINT=https://<account-name>.documents.azure.com:443/
AZURE_COSMOS_DB_DATABASE=cosmicworks
AZURE_COSMOS_DB_CONTAINER=products

# ---------
# Azure messaging (nonsecret Terraform outputs; DefaultAzureCredential only)
# ---------

# event_grid_topic_endpoint
AZURE_EVENT_GRID_TOPIC_ENDPOINT=https://<topic-name>.<region>-1.eventgrid.azure.net/api/events

# event_hubs_namespace_fqdn (hostname only), event_hub_name,
# event_hub_consumer_group_name
AZURE_EVENT_HUBS_FULLY_QUALIFIED_NAMESPACE=<event-hubs-namespace>.servicebus.windows.net
AZURE_EVENT_HUB_NAME=events
AZURE_EVENT_HUB_CONSUMER_GROUP='$Default'

# service_bus_namespace_fqdn (hostname only), service_bus_queue_name
AZURE_SERVICE_BUS_FULLY_QUALIFIED_NAMESPACE=<service-bus-namespace>.servicebus.windows.net
AZURE_SERVICE_BUS_QUEUE_NAME=queue

# queue_storage_endpoint (Queue, not Blob/DFS), queue_storage_queue_name
AZURE_QUEUE_STORAGE_ENDPOINT=https://<storage-account>.queue.core.windows.net/
AZURE_QUEUE_STORAGE_QUEUE_NAME=<terraform-queue-name>

# ---------
# Azure observability (nonsecret IDs; see docs/monitoring.md for Terraform mapping)
# ---------

# azure_monitor_id -> AZURE_MONITOR_ID
# ARM resource ID: Microsoft.Monitor/accounts (managed Prometheus workspace)
AZURE_MONITOR_ID=

# log_analytics_workspace_id -> AZURE_LOG_ANALYTICS_WORKSPACE_ID
# Workspace/customer GUID, NOT log_analytics_id (the workspace ARM resource ID)
AZURE_LOG_ANALYTICS_WORKSPACE_ID=

# application_insights_id -> AZURE_APPLICATION_INSIGHTS_ID
# ARM resource ID: Microsoft.Insights/components
AZURE_APPLICATION_INSIGHTS_ID=

# network_watcher_id -> AZURE_NETWORK_WATCHER_ID
# ARM resource ID: Microsoft.Network/networkWatchers (may use a different RG)
AZURE_NETWORK_WATCHER_ID=

# az account show --query id --output tsv, or an ARM ID's subscription segment
# NOT activity_log_id, which identifies an export diagnostic setting
AZURE_SUBSCRIPTION_ID=

# Optional list-watchers/list-events/summarize-events filter; empty means no RG filter
# resource_group_name is the scenario group; an existing watcher may use another RG
AZURE_RESOURCE_GROUP=

# Local telemetry emission only; keep empty here. Retrieve privately from the portal.
# Never commit, print, or pass this value as a CLI argument.
APPLICATIONINSIGHTS_CONNECTION_STRING=
